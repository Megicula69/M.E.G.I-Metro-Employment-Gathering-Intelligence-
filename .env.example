# Copy to .env, then replace the placeholders. Never share or commit .env.
DISCORD_TOKEN=replace_with_your_bot_token
DATABASE_URL=postgresql+psycopg://jobbot:replace_with_password@localhost:5432/jobbot
# Optional: faster slash-command registration in one test server.
DISCORD_TEST_GUILD_ID=
# Philippine Jooble API access is optional. Keep approval false until Jooble
# explicitly permits short job cards in your Discord server(s).
JOOBLE_PH_API_KEY=
JOOBLE_DISCORD_APPROVED=false
JOOBLE_KEYWORDS=jobs
# Set only to a retention period Jooble explicitly permits for your integration.
# Zero stores no results between sequential fetches; concurrent servers still share one request.
JOOBLE_CACHE_SECONDS=0
# JobStreet/SEEK, Indeed PH, PhilJobNet, and Kalibrr have no enabled adapter.
# No credentials for them are used or requested by this version.
